{
    "timeout": 1800,
    "source": {
        "directories": [
            "../../src"
        ]
    },
    "logs": {
        "text": "../../var/infection.log",
        "summary": "../../var/infection-summary.log",
        "json": "../../var/infection.json",
        "perMutator": "../../var/infection-per-mutator.md",
        "github": true
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "ignoreMsiWithNoMutations": true,
    "mutators": {
        "@default": true,
        "Decrement": false,
        "DecrementInteger": false,
        "FunctionCallRemoval": false,
        "Increment": false,
        "InstanceOf_": false,
        "LogicalAnd": false,
        "LogicalAndAllSubExprNegation": false,
        "LogicalAndNegation": false,
        "LogicalNot": false,
        "MethodCallRemoval": false,
        "Minus": false,
        "Throw_": false,
        "TrueValue": false,
        "Yield_": false,
        "YieldValue": false
    }
}
