{
    "name": "react-parallel/limited-pool",
    "description": "\ud83c\udfd4\ufe0f Limited pool for ext-parallel",
    "license": "MIT",
    "authors": [
        {
            "name": "Cees-Jan Kiewiet",
            "email": "ceesjank@gmail.com",
            "homepage": "http://wyrihaximus.net/"
        }
    ],
    "require": {
        "php": "^8.2",
        "react-parallel/contracts": "dev-ensure-void-returntype-translates-to-null",
        "react/async": "^4.2",
        "react/event-loop": "^1.5",
        "react/promise": "^3.2",
        "wyrihaximus/pool-info": "^2"
    },
    "require-dev": {
        "ext-parallel": "*",
        "moneyphp/money": "^3.2",
        "react-parallel/event-loop": "dev-2.x-ensure-void-returntype-translates-to-null",
        "react-parallel/infinite-pool": "dev-3.x-template-types",
        "react-parallel/runtime": "dev-3.x-use-stubs-from-stubs-package",
        "wyrihaximus/async-test-utilities": "^7.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "ReactParallel\\Pool\\Limited\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReactParallel\\Tests\\Pool\\Limited\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "icanhazstring/composer-unused": true,
            "infection/extension-installer": true,
            "ocramius/package-versions": true
        },
        "platform": {
            "php": "8.2.13"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "composer normalize"
        ],
        "post-update-cmd": [
            "composer normalize"
        ]
    }
}
