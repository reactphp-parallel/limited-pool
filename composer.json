{
    "name": "react-parallel/limited-pool",
    "description": "\ud83c\udfd4\ufe0f Limited pool for ext-parallel",
    "license": "MIT",
    "authors": [
        {
            "name": "Cees-Jan Kiewiet",
            "email": "ceesjank@gmail.com",
            "homepage": "http://wyrihaximus.net/"
        }
    ],
    "require": {
        "php": "^8.1",
        "react-parallel/contracts": "^2@dev",
        "react/async": "^4.2",
        "react/event-loop": "^1.5",
        "react/promise": "^2 || ^3.1",
        "wyrihaximus/pool-info": "^1.1 || ^2"
    },
    "require-dev": {
        "ext-parallel": "*",
        "moneyphp/money": "^3.2",
        "react-parallel/event-loop": "^2@dev",
        "react-parallel/infinite-pool": "^3@dev",
        "react-parallel/pool-tests": "^4@dev",
        "react-parallel/runtime": "^3@dev",
        "wyrihaximus/async-test-utilities": "^5 || ^7.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "ReactParallel\\Pool\\Limited\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReactParallel\\Tests\\Pool\\Limited\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "icanhazstring/composer-unused": true,
            "infection/extension-installer": true,
            "ocramius/package-versions": true
        },
        "platform": {
            "php": "8.1.13"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "composer normalize"
        ],
        "post-update-cmd": [
            "composer normalize"
        ]
    }
}
